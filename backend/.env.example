APP_NAME=QBankCTU API
APP_VERSION=0.2.0
APP_ENV=development
# Demo login is disabled unless explicitly enabled.
DEMO_MODE=false
# Set these only in a local/demo environment when DEMO_MODE=true.
DEMO_ADMIN_EMAIL=admin@qbankctu.edu.vn
DEMO_ADMIN_PASSWORD=
DEMO_REVIEWER_EMAIL=reviewer@qbankctu.edu.vn
DEMO_REVIEWER_PASSWORD=
HOST=0.0.0.0
PORT=8000

MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/
AUTH_DB_NAME=NCKH
RAG_DB_NAME=rag_database
MONGO_CONNECT_TIMEOUT_MS=10000
JOB_RECOVERY_TIMEOUT_MINUTES=120

FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
API_PREFIX=/api/v1

MODEL_PROVIDER=qwen
EVALUATION_MODEL_PROVIDER=deepseek-r1
# Use Qwen as the evaluator model.
# EVALUATION_MODEL_PROVIDER=qwen
# Use any Ollama model for evaluator with the ollama:<model-name> form.
# EVALUATION_MODEL_PROVIDER=ollama:qwen2.5:7b
DEEPSEEK_MODEL_NAME=deepseek-r1
PROMPT_SOURCE=file
CHROMADB_COLLECTION_NAME=chunks
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMADB_PATH=./data/chroma_data
UPLOAD_DIR=./data/uploads
OCR_OUTPUT_DIR=./data/ocr_outputs
# Optional on Windows when Poppler is not in PATH.
# POPPLER_PATH=C:\poppler\Library\bin
